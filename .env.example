# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# The ANON key is safe to expose in the browser (that is its purpose), but it is
# only safe if Row Level Security is enabled on every table. See
# "supabase sql code/security-rls-policies.sql".

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# The values below are NOT used by the frontend. They belong in the Supabase
# dashboard under Edge Functions -> Secrets. Listed here for reference only.
#
#   SUPABASE_SERVICE_ROLE_KEY   (never expose to the browser)
#   ALLOWED_ORIGINS             comma-separated, e.g. https://gpcrm.app,https://www.gpcrm.app
#   KHALTI_SECRET_KEY
#   ESEWA_SECRET_KEY
#   ESEWA_MERCHANT_CODE
#   SITE_URL                    e.g. https://gpcrm.app
#   ALLOW_PAYMENT_SIMULATION    leave UNSET in production (only "true" enables it)
